# ===== GEO Rewrite Workbench 环境变量示例 =====
# 复制为 .env 后填写真实值，.env 不会被提交到代码库

# ---- 数据库 ----
# P0 使用 SQLite，文件路径（相对 backend 目录）
DATABASE_URL=sqlite:///./geo_rewrite.db

# ---- LLM 配置（OpenAI 兼容接口）----
# API Key（必填，否则改写任务会失败）
LLM_API_KEY=sk-your-api-key-here

# Base URL：OpenAI 官方留空即可；兼容 Provider 填对应地址
# OpenAI:      https://api.openai.com/v1
# DeepSeek:    https://api.deepseek.com/v1
# 通义千问:     https://dashscope.aliyuncs.com/compatible-mode/v1
# 豆包(火山):   https://ark.cn-beijing.volces.com/api/v3
LLM_BASE_URL=https://api.openai.com/v1

# 模型名称
LLM_MODEL=gpt-4o-mini

# Provider 标识：openai / deepseek / qwen / doubao
LLM_PROVIDER=openai

# 请求超时（秒）—— v0.1-beta 默认 120s，避免 DeepSeek 等偶发超时
LLM_TIMEOUT=120

# ---- 跨域 ----
# 前端开发地址，多个用逗号分隔
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- 可选：质量检查 Call 3（P0 默认关闭）----
ENABLE_QUALITY_CHECK=false

# ---- 模型配置加密密钥（用于加密用户配置的 API Key）----
# 必填：用于加密存储用户模型 API Key。生产环境必须使用随机强密钥，不要提交真实值到 Git。
# 生成命令：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 留空或保持 change-me 将导致模型配置无法保存。
MODEL_CONFIG_SECRET_KEY=change-me
